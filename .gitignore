# Python bytecode & tool caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Microsoft Office & editor temporary / lock files
~$*
*.tmp
*.bak
*.swp

# OS metadata caches
.DS_Store
Thumbs.db
Desktop.ini

# Local environment secrets (never commit credentials)
.env
.env.*
!.env.example
